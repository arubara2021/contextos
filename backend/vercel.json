{
  "version": 2,
  "builds": [
    {
      "src": "src/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "src/api/[...path].ts",
      "use": "@vercel/node"
    },
    {
      "src": "src/api/cron/decay-scan.ts",
      "use": "@vercel/node"
    },
    {
      "src": "src/api/cron/reminders.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/cron/(.*)",
      "dest": "/src/api/cron/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/src/api/index"
    }
  ]
}