{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node@3"
    },
    {
      "src": "api/[...path].ts",
      "use": "@vercel/node@3"
    },
    {
      "src": "api/cron/decay-scan.ts",
      "use": "@vercel/node@3"
    },
    {
      "src": "api/cron/reminders.ts",
      "use": "@vercel/node@3"
    }
  ],
  "routes": [
    {
      "src": "/api/cron/(.*)",
      "dest": "/api/cron/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    }
  ]
}