NODE_ENV=development
PORT=3001

COCKROACH_CONNECTION_STRING=postgresql://user:password@host:26257/contextos?sslmode=require

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

DEV_BYPASS_AUTH=true
DEV_BYPASS_TOKEN=dev-bypass-token
DEV_BYPASS_EMAIL=demo@contextos.local

CORS_ORIGIN=*
CORS_FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

DB_POOL_MAX=20
DB_MAX_CONNECTIONS=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=20000
DB_STATEMENT_TIMEOUT_MS=30000

AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_ENABLED=true
BEDROCK_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0
BEDROCK_EXTRACTION_MODEL_ID=eu.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_REQUEST_TIMEOUT_MS=60000
BEDROCK_MAX_TOKENS=4096
BEDROCK_EXTRACTION_MAX_TOKENS=8192
BEDROCK_EXTRACTION_TEMPERATURE=0.2

S3_BUCKET_NAME=contextos-dev

AI_DEFAULT_PROVIDER=
AI_FALLBACK_PROVIDERS=
AI_STRICT_MODE=true
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=500

AI_CHAT_MODEL=
AI_EXTRACTION_MODEL=
AI_EMBEDDING_MODEL=

AI_MIN_CONCEPTS_TINY=1
AI_MIN_CONCEPTS_SMALL=3
AI_MIN_CONCEPTS_LARGE=10
