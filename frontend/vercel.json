{
    "version": 2,
    "framework": null,
    "installCommand": "cd backend && npm install && cd ../frontend && npm install",
    "buildCommand": "cd frontend && npm run build",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/decay-scan",
            "schedule": "0 */4 * * *"
        },
        {
            "path": "/api/cron/reminders",
            "schedule": "0 0 * * *"
        }
    ]
}